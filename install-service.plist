<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentos.server</string>

    <key>Description</key>
    <string>AgentOS - AI Agent Governance Platform</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Applications/AgentOS/server.js</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/agentos.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/agentos.error.log</string>

    <key>WorkingDirectory</key>
    <string>/Applications/AgentOS</string>

    <key>UserName</key>
    <string>root</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
